// Windows resource file — embeds the application icon and version metadata
// Referenced in CMakeLists.txt via windows/OSMV.rc
#include <winver.h>
#include "common/version.hpp"

#define IDI_ICON1 101
IDI_ICON1 ICON "OSMV_logo.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION OSMV_VERSION_MAJOR,OSMV_VERSION_MINOR,OSMV_VERSION_PATCH,0
 PRODUCTVERSION OSMV_VERSION_MAJOR,OSMV_VERSION_MINOR,OSMV_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "StreamMusicViewer"
            VALUE "FileDescription", "OBS Stream Music Viewer (OSMV)"
            VALUE "FileVersion", OSMV_VERSION_STR
            VALUE "InternalName", "OSMV"
            VALUE "LegalCopyright", "GNU General Public License v3.0 (GPL-3.0)"
            VALUE "OriginalFilename", "OSMV.exe"
            VALUE "ProductName", "OBS Stream Music Viewer (OSMV)"
            VALUE "ProductVersion", OSMV_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
